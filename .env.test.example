# Copy this file to .env.test (gitignored) before running `npm test`.
#
# TEST_MONGODB_URI MUST point at a dedicated, disposable database — never a
# dev or production database. setup.ts wipes all collections after every
# test and will refuse to start if the database name doesn't contain "test",
# as a guard against pointing this at real data by mistake.
#
# Example using the local docker-compose Mongo container (see docker-compose.yml),
# on a separate database name from the dev "mahallu-erp" database it also hosts:
TEST_MONGODB_URI=mongodb://root:rootpassword@localhost:27017/mahallu-erp-test?authSource=admin

# Optional. If unset or unreachable, Redis-backed behavior (JWT blacklist)
# degrades to a no-op fallback (see src/config/redis.ts) rather than failing
# tests — only set this if you want blacklist-dependent tests to actually
# exercise Redis. Points at the same local docker-compose Redis container
# dev uses; blacklist keys are token-value-keyed so this is safe to share.
REDIS_URL=redis://:redispassword@localhost:6379

# The app reads these at various points during request handling; tests need
# them set even though most test suites won't exercise every integration.
NODE_ENV=test
JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
